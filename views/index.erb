<div class="glide">

<div class="glide__track" data-glide-el="track">
    <ul class="glide__slides">
      <li class="glide__slide">0</li>
      <li class="glide__slide">1</li>
      <li class="glide__slide">2</li>
    </ul>
  </div>
</div>
<%require "date" %>

<% if @admin == 'true' %>
<form action="/new" method="post">
  <input type="text" name="title">
  <input type="submit" value="Submit">
</form>
 <% end %><% @updates.each do |update| %>
<form action="/edit" method="post" id="id-<%=update[0]%>">
<div id = "update-<%=update[0]%>">
<p id=date-<%=update[0]%>><%= Time.at(Integer(update[3])).strftime("%Y/") %> </p>
<input  name = "title" value = "<%= update[1] %>" <% if @admin != 'true' %> disabled <% end %>>
<input name ="content"id=content-<%=update[0]%> value="<%=update[2]%>"  <% if @admin != 'true' %> disabled <% end %>>
<input value ="<%=update[0]%>" name = "id" hidden >  
<% if @admin == 'true' %>
<input type="submit" value ="Submit">
</form>
 <% end %>
 <% end %>

<script>
var sliders = document.querySelectorAll('.glide');

for (var i = 0; i < sliders.length; i++) {
  var glide = new Glide(sliders[i], {
    // options
  });

  glide.mount()
}
</script






 
