<% @updates.each do |update| %>
<div id = "update-<%=update[0]%>">
<p id=date-<%=update[0]%>><%= update[3] %> </p>
<h1 id=title-<%=update[0]%>> <%= update[0] %>.<%= update[1] %></h1>
<p id=content-<%=update[0]%>><%= update[2] %><p>
<% if @admin == 'true' %>
<form action="/edit" method="post" id="id-<%=update[0]%>" hidden='true'>
  <input type="text" name="title">
  <input type="text" name="content">
  <input type="submit" value="Submit">
  <input type="text" name="id-<%=update[0]%>">
<%=update[0]%>
</form>
<button onclick="edit('<%= update[0] %>')">
    edit
</button> 
 <% end %>
 <% end %>

<script>
function edit(id) {
    document.getElementById('update-' + id).style.display = 'none';
    document.getElementById('id-' + id).hidden = false;
}
</script>

<% if @admin == 'true' %>
<form action="/new" method="post">
  <input type="text" name="title">
  <input type="text" name="content">
  <input type="submit" value="Submit">
</form>
 <% end %>




 
